# Copy this file to .env and fill in your Plaid credentials.
# This .env is LOCAL ONLY — it is git-ignored and must never be committed.
# The deployed app does NOT use this file; it reads credentials from Secret Manager.

PLAID_CLIENT_ID=your-client-id-here
PLAID_SECRET=your-sandbox-secret-for-testing-first
PLAID_ENV=sandbox

# Optional: the GCP project that holds the plaid-access-* secrets.
# If omitted, the gcloud CLI uses its active configured project
# (see `gcloud config get-value project`).
# GCP_PROJECT_ID=your-gcp-project-id
